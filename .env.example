# 공공데이터포털 인증키 (Encoding 키를 그대로 넣으면 됩니다)
# 값에 %2B, %3D 같은 퍼센트 인코딩이 있으면 그대로 사용하고, 없으면 서버가 한 번 인코딩합니다.
SERVICE_KEY=0r12dGCCu8TOF%2BupSP4ZBLBIoEDfURRfuPo02NDCNkI7bOLBd5rvljznDu4KVxT%2B%2BFuYrEMyAqf%2F9OqRJFqJPA%3D%3D

# 서비스 주소 (기본값이 이미 세종시 도로안전표지 서비스입니다)
API_ENDPOINT=https://apis.data.go.kr/5690000/sjRoadSign
API_OPERATION=sj_00000270

PORT=3000

# 한 번에 가져올 행 수와 전체 상한. 일일 트래픽이 5,000건이라 상한을 둡니다.
NUM_OF_ROWS=500
MAX_RECORDS=3000

# 조회 결과 캐시 유지 시간(ms). 기본 6시간.
CACHE_TTL_MS=21600000

# ── 지도 공급자 (위에서부터 우선 적용, 하나만 채우면 됩니다) ────────────
# 네이버 클라우드 플랫폼 > Maps > Web Dynamic Map 의 Client ID(ncpKeyId)
NAVER_MAP_CLIENT_ID=
# 카카오 개발자센터 > 내 애플리케이션 > JavaScript 키
KAKAO_MAP_JS_KEY=
# VWorld(국토교통부) 오픈API 인증키. 위 둘이 없을 때 국내 배경지도로 사용합니다.
VWORLD_KEY=
